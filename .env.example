# ==============================================================================
# Web Scraper Toolkit - Environment Variables
# Copy to .env and fill in your values
# ==============================================================================

# --- Proxy Configuration (Required for anti-bot bypass at scale) ---
# Residential proxy URL (BrightData, Oxylabs, Smartproxy, etc.)
# Format: http://user:pass@host:port or socks5://user:pass@host:port
PROXY_URL=
# Optional: proxy rotation endpoint for automatic IP switching
PROXY_ROTATION_URL=
# Proxy provider API key (for managing sessions/IPs programmatically)
PROXY_API_KEY=

# --- Firecrawl Self-Hosted ---
FIRECRAWL_HOST=http://localhost:3002
FIRECRAWL_API_KEY=fc-local-dev
# Number of concurrent browser instances
FIRECRAWL_NUM_WORKERS=4
# Rate limit: requests per minute per domain
FIRECRAWL_RATE_LIMIT=30
# Playwright browser path (pre-installed in this environment)
PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers

# --- Crawl4AI ---
CRAWL4AI_BASE_URL=http://localhost:11235
# Max concurrent crawls
CRAWL4AI_MAX_CONCURRENT=5
# Default extraction strategy: bm25 | pruning | semantic
CRAWL4AI_DEFAULT_STRATEGY=pruning
# Enable stealth mode by default
CRAWL4AI_STEALTH_MODE=true

# --- Browser / Playwright ---
# Headless mode (true for production, false for debugging)
BROWSER_HEADLESS=true
# Browser viewport
BROWSER_VIEWPORT_WIDTH=1920
BROWSER_VIEWPORT_HEIGHT=1080
# Page load timeout in ms
BROWSER_TIMEOUT=30000
# User agent rotation (comma-separated list or "auto")
BROWSER_USER_AGENTS=auto

# --- Output ---
# Where processed markdown files are stored
OUTPUT_DIR=./data/output
# Format: markdown | json | both
OUTPUT_FORMAT=markdown
# Include metadata (timestamps, source URL, extraction stats)
OUTPUT_INCLUDE_META=true

# --- Anti-Bot / Stealth ---
# Enable playwright-stealth patches
STEALTH_ENABLED=true
# Simulate human behavior (mouse movements, scroll, delays)
HUMAN_SIMULATION=true
# Random delay range between requests (ms): min,max
REQUEST_DELAY_RANGE=1000,3000
# Max retries on block/captcha detection
MAX_RETRIES_ON_BLOCK=3

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=./data/scraper.log
