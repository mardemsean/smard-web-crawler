# ==============================================================================
# SMard Web Crawler - environment
# Looked up in order: $SMARD_ENV_FILE, ./.env, ~/.smard-crawler/.env
# (real environment variables always win). Never commit the filled-in copy.
# ==============================================================================

# --- Fallback chain -----------------------------------------------------------
# Engines are tried left to right; unavailable or unconfigured ones are skipped.
ENGINE_ORDER=obscura,crawl4ai,firecrawl,cloakbrowser,site_unblocker,web_data_api
# Check robots.txt before every scrape (RFC 9309; unreachable robots.txt = disallow)
RESPECT_ROBOTS=true
ROBOTS_USER_AGENT=SMardCrawler

# --- Residential proxy (used by Obscura, Crawl4AI, Firecrawl, CloakBrowser) ----
# Format: http://user:pass@gate.decodo.com:7000
PROXY_URL=

# --- Obscura (lightweight stealth headless browser, CDP) ----------------------
OBSCURA_ENABLED=true
# Docker: ws://localhost:9222 . Local binary: any free loopback port.
OBSCURA_CDP_URL=ws://localhost:9222
# Required for the Docker service (non-loopback bind inside the container), >= 32 chars
OBSCURA_CDP_TOKEN=
# Path to a local `obscura` binary; when set and OBSCURA_CDP_URL is loopback,
# the crawler starts it on demand (no daemon needed). Installers fill this in.
OBSCURA_BIN=
OBSCURA_MAX_SESSIONS=8
# Keep these consistent with the proxy exit region (fingerprint coherence)
OBSCURA_TIMEZONE=
OBSCURA_GEOLOCATION=

# --- Crawl4AI (Docker server) -------------------------------------------------
CRAWL4AI_BASE_URL=http://localhost:11235
CRAWL4AI_API_TOKEN=
CRAWL4AI_MAX_CONCURRENT=5
# Markdown content filter: pruning | bm25 | none
CRAWL4AI_DEFAULT_STRATEGY=pruning

# --- Firecrawl self-hosted (scripts/firecrawl-up.sh) --------------------------
FIRECRAWL_HOST=http://localhost:3002
FIRECRAWL_API_KEY=fc-local-dev

# --- CloakBrowser (local stealth Chromium; needs `pip install cloakbrowser` + license) ---
CLOAKBROWSER_ENABLED=false
# Free tier allows one concurrent session
CLOAKBROWSER_MAX_SESSIONS=1
CLOAKBROWSER_HUMANIZE=false

# --- Decodo Site Unblocker (paid, level 2) ------------------------------------
# Format: https://user:pass@unblock.decodo.com:60000
SITE_UNBLOCKER_URL=
SITE_UNBLOCKER_FALLBACK=true

# --- Decodo Web Data API (paid, level 3) --------------------------------------
DECODO_API_KEY=
DECODO_API_URL=https://data.decodo.com/v1
DECODO_API_FALLBACK=true

# --- Cost guard for the paid engines ------------------------------------------
# Max paid requests per second (0 = unlimited) and per day (0 = unlimited)
DECODO_MAX_RPS=2
DECODO_DAILY_LIMIT=1000
# Defaults to ~/.smard-crawler/budget.json
BUDGET_STATE_FILE=

# --- HTTP API / MCP -----------------------------------------------------------
# Bearer token for `smard-crawler serve`; mandatory for non-loopback binds (>= 32 chars)
SMARD_API_TOKEN=
# Allow scraping private/internal addresses via the API/MCP (SSRF guard). Keep false.
SMARD_ALLOW_PRIVATE=false

# --- Browser ------------------------------------------------------------------
BROWSER_HEADLESS=true
BROWSER_VIEWPORT_WIDTH=1920
BROWSER_VIEWPORT_HEIGHT=1080
BROWSER_TIMEOUT=30000

# --- Stealth (Crawl4AI magic/override_navigator/simulate_user) ----------------
STEALTH_ENABLED=true
HUMAN_SIMULATION=true

# --- Output -------------------------------------------------------------------
OUTPUT_DIR=./data/output
OUTPUT_INCLUDE_META=true

# --- Logging ------------------------------------------------------------------
LOG_LEVEL=INFO
